.previewVest::after{
  content:"♥";position:absolute;font-size:18px;color:#ef718c
}
.previewStars::before,.previewSlippers::before{
  content:"";width:30px;height:16px;border-radius:10px;background:#ffe178;border:3px solid #65c0ea;
