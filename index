<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#d46a3a">
<title>Cinna Care</title>
<style>
:root{
  --ink:#6d4024;
  --line:#7a4d31;
  --cream:#fff6ea;
  --cream2:#ffe8c8;
  --gold:#f4bc39;
  --shadow:0 10px 24px rgba(74,35,12,.22);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#24130b;font-family:ui-rounded,"SF Pro Rounded","Nunito",system-ui,sans-serif}
button{font:inherit}
#game{
  position:relative;width:100vw;height:100dvh;max-width:520px;margin:auto;overflow:hidden;
  background:url("data:image/png;base64,") center/cover no-repeat;
  user-select:none;
}
#game::after{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(to bottom,rgba(0,0,0,.05),transparent 18%,transparent 70%,rgba(58,20,6,.10));
}

.hud{
  position:absolute;z-index:30;top:calc(env(safe-area-inset-top) + 10px);left:8px;right:8px;
  display:grid;grid-template-columns:repeat(5,1fr);gap:6px
}
.stat{
  min-width:0;padding:7px 4px 6px;border-radius:16px;
  background:linear-gradient(var(--cream),var(--cream2));
  border:2px solid rgba(128,74,40,.2);box-shadow:0 4px 10px rgba(65,28,9,.15),inset 0 1px 0 rgba(255,255,255,.9);
  color:var(--ink);text-align:center
}
.stat .top{display:flex;align-items:center;justify-content:center;gap:4px;font-size:12px;font-weight:900;line-height:1;white-space:nowrap}
.stat .ico{font-size:16px}
.bar{margin-top:5px;height:5px;border-radius:999px;background:rgba(102,65,38,.17);overflow:hidden}
.fill{height:100%;width:50%;border-radius:999px;transition:width .45s ease, background .3s ease}
.coins .bar{visibility:hidden}
.coinIcon,.miniCoin{
  display:inline-grid;place-items:center;border-radius:50%;
  background:linear-gradient(#ffe37d,#ffbf34);border:2px solid #cc8c18;color:#fff9c9;
  font-weight:900;line-height:1;box-shadow:inset 0 1px 1px rgba(255,255,255,.55)
}
.coinIcon{width:18px;height:18px;font-size:11px}
.miniCoin{width:15px;height:15px;font-size:9px}

.bubbleHudIcon{position:relative;display:inline-block;width:18px;height:16px;vertical-align:middle}
.bubbleHudIcon i{
  position:absolute;border-radius:50%;
  background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.95), rgba(255,255,255,.45) 40%, rgba(126,215,255,.28) 72%, rgba(126,215,255,.08) 100%);
  border:1px solid rgba(255,255,255,.65)
}
.bubbleHudIcon i:nth-child(1){width:10px;height:10px;left:0;top:5px}
.bubbleHudIcon i:nth-child(2){width:12px;height:12px;left:6px;top:2px}
.bubbleHudIcon i:nth-child(3){width:7px;height:7px;left:11px;top:0}

#offlineBanner,#toast{
  position:absolute;left:50%;transform:translateX(-50%);z-index:80;
  max-width:88%;padding:9px 13px;border-radius:16px;text-align:center;
  font-size:12px;font-weight:900;box-shadow:var(--shadow);opacity:0;pointer-events:none;
  transition:.22s ease
}
#offlineBanner{
  top:98px;background:rgba(255,247,232,.96);color:#6c432c;border:2px solid rgba(119,72,40,.16)
}
#offlineBanner.show{opacity:1;transform:translateX(-50%) translateY(0)}
#toast{
  bottom:102px;background:rgba(80,45,27,.94);color:#fff;transform:translateX(-50%) translateY(10px)
}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

#petMover{
  --x:0px;
  position:absolute;left:50%;bottom:21.4%;width:min(75vw,340px);
  transform:translateX(calc(-50% + var(--x)));transition:transform 1.3s cubic-bezier(.22,.84,.24,1);
  z-index:15
}
#thought{
  position:absolute;left:50%;top:-16px;transform:translate(-50%,-100%) scale(.9);
  background:rgba(255,249,239,.96);border:2px solid rgba(117,70,40,.22);color:#71452c;
  padding:8px 12px;border-radius:18px;font-weight:900;font-size:13px;box-shadow:var(--shadow);
  opacity:0;transition:.2s ease;white-space:nowrap;pointer-events:none
}
#thought.show{opacity:1;transform:translate(-50%,-100%) scale(1)}
#petSprite{
  position:relative;width:100%;filter:drop-shadow(0 9px 7px rgba(71,37,22,.22));
  transform-origin:50% 88%;animation:breathe 2.8s ease-in-out infinite
}
@keyframes breathe{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-2px) scale(1.008,.995)}}

#petSvg{display:block;width:100%;height:auto;overflow:visible}
.svgImage{image-rendering:auto}
.rigPart,.eyeTrack,.liveEye{transform-box:fill-box;transform-origin:center center}
#bodyBob{transform-box:fill-box;transform-origin:center center}
.pet-ear-left{transform-origin:128px 47px;animation:earFloatL 2.8s ease-in-out infinite}
.pet-ear-right{transform-origin:307px 47px;animation:earFloatR 2.8s ease-in-out infinite}
.pet-tail{transform-origin:270px 135px;animation:tailIdle 2.4s ease-in-out infinite}
.pet-arm-left{transform-origin:144px 121px;animation:armIdleL 2.2s ease-in-out infinite}
.pet-arm-right{transform-origin:255px 108px;animation:armIdleR 2.2s ease-in-out infinite}
@keyframes earFloatL{0%,100%{transform:rotate(-.9deg)}50%{transform:rotate(1.4deg) translateY(.6px)}}
@keyframes earFloatR{0%,100%{transform:rotate(.9deg)}50%{transform:rotate(-1.4deg) translateY(.6px)}}
@keyframes tailIdle{0%,100%{transform:rotate(-1deg)}50%{transform:rotate(3.2deg)}}
@keyframes armIdleL{0%,100%{transform:rotate(0deg)}50%{transform:rotate(1.4deg) translateY(-.3px)}}
@keyframes armIdleR{0%,100%{transform:rotate(0deg)}50%{transform:rotate(-1.4deg) translateY(-.3px)}}

.liveEye{fill:#52b8e7;animation:liveBlink 5.4s infinite}
@keyframes liveBlink{
  0%,7.4%,9.5%,57%,59.1%,100%{transform:scaleY(1)}
  8.3%,58.0%{transform:scaleY(.06)}
}
.eyeCover{fill:#fffdfa}
.eyeShine{fill:rgba(255,255,255,.76)}

#petSprite.walking #bodyBob{animation:bodyWalk .3s infinite alternate ease-in-out}
#petSprite.walking .pet-ear-left{animation:walkEarL .30s infinite alternate ease-in-out}
#petSprite.walking .pet-ear-right{animation:walkEarR .30s infinite alternate ease-in-out}
#petSprite.walking .pet-arm-left{animation:walkArmL .30s infinite alternate ease-in-out}
#petSprite.walking .pet-arm-right{animation:walkArmR .30s infinite alternate ease-in-out}
#petSprite.walking .pet-tail{animation:walkTail .30s infinite alternate ease-in-out}
@keyframes bodyWalk{from{transform:translateY(0)}to{transform:translateY(-3px)}}
@keyframes walkEarL{from{transform:rotate(-1.8deg)}to{transform:rotate(1.2deg) translateY(1px)}}
@keyframes walkEarR{from{transform:rotate(1.8deg)}to{transform:rotate(-1.2deg) translateY(1px)}}
@keyframes walkArmL{from{transform:rotate(3.5deg)}to{transform:rotate(-3.5deg)}}
@keyframes walkArmR{from{transform:rotate(-3.5deg)}to{transform:rotate(3.5deg)}}
@keyframes walkTail{from{transform:rotate(-2.4deg)}to{transform:rotate(4.6deg)}}

#petSprite.jump{animation:jump .72s cubic-bezier(.2,.75,.25,1)}
#petSprite.jump .pet-ear-left{animation:jumpEarL .72s ease-out}
#petSprite.jump .pet-ear-right{animation:jumpEarR .72s ease-out}
@keyframes jump{
  0%{transform:translateY(0) scale(1)}
  32%{transform:translateY(-46px) scale(.98,1.04) rotate(-2deg)}
  58%{transform:translateY(-50px) scale(1.01,.99) rotate(2deg)}
  82%{transform:translateY(3px) scale(1.05,.93)}
  100%{transform:translateY(0) scale(1)}
}
@keyframes jumpEarL{0%,100%{transform:rotate(-.9deg)}42%{transform:rotate(3deg) translateY(2px)}}
@keyframes jumpEarR{0%,100%{transform:rotate(.9deg)}42%{transform:rotate(-3deg) translateY(2px)}}

#petSprite.wiggle{animation:wiggle .78s ease-in-out}
@keyframes wiggle{
  0%,100%{transform:rotate(0)}
  20%{transform:rotate(-4deg) translateY(-2px)}
  40%{transform:rotate(4deg) translateY(-3px)}
  60%{transform:rotate(-3deg) translateY(-2px)}
  80%{transform:rotate(2deg)}
}
#petSprite.sleepy{animation:sleepy 2.2s ease-in-out infinite}
#petSprite.sleepy .liveEye{animation:none;transform:scaleY(.08)}
@keyframes sleepy{0%,100%{transform:translateY(0)}50%{transform:translateY(3px) rotate(1.2deg)}}
#petSprite.farting .pet-tail{animation:fartTail .15s infinite alternate ease-in-out}
@keyframes fartTail{from{transform:rotate(-5deg)}to{transform:rotate(6deg)}}

#petSprite.sleepPose{
  transform-origin:52% 78%;
  animation:sideSleep 2.1s ease-in-out infinite;
}
#petSprite.sleepPose .liveEye{animation:none;transform:scaleY(.06)}
#petSprite.sleepPose .pet-ear-left{animation:sleepEarL 2.1s ease-in-out infinite}
#petSprite.sleepPose .pet-ear-right{animation:sleepEarR 2.1s ease-in-out infinite}
#petSprite.sleepPose .pet-tail{animation:sleepTail 2.1s ease-in-out infinite}
@keyframes sideSleep{
  0%,100%{transform:translate(-2px,18px) rotate(-86deg) scale(.94)}
  50%{transform:translate(-4px,20px) rotate(-86deg) scale(.948,.934)}
}
@keyframes sleepEarL{0%,100%{transform:rotate(-1deg)}50%{transform:rotate(2deg) translateY(1px)}}
@keyframes sleepEarR{0%,100%{transform:rotate(1deg)}50%{transform:rotate(-2deg) translateY(1px)}}
@keyframes sleepTail{0%,100%{transform:rotate(-2deg)}50%{transform:rotate(2deg)}}

#petSprite.lookBack{animation:lookBackPose 1.1s ease-in-out}
#petSprite.scared{
  animation:scaredShake .14s ease-in-out infinite alternate;
}
#petSprite.scared .brow{opacity:.95}
#petSprite.scared .liveEye{transform:scale(1.08)}
@keyframes lookBackPose{
  0%{transform:translateX(0) rotate(0deg)}
  30%{transform:translateX(-12px) rotate(-8deg)}
  68%{transform:translateX(-10px) rotate(-11deg)}
  100%{transform:translateX(0) rotate(0deg)}
}
@keyframes scaredShake{
  from{transform:translateX(-2px) rotate(-1deg)}
  to{transform:translateX(2px) rotate(1deg)}
}

.cosmeticSvg{display:none;pointer-events:none}
.cosmeticSvg .softStroke{stroke:#65c0ea;stroke-width:4;stroke-linecap:round;stroke-linejoin:round}
.cosmeticSvg .shade{opacity:.55}
.previewBeret::before{
  content:"";width:55px;height:27px;border-radius:54% 54% 44% 44%;
  background:linear-gradient(#ffd0dc,#f5a0b8);border:3px solid #65c0ea;transform:rotate(-6deg)
}
.previewBeret::after{
  content:"";position:absolute;width:13px;height:9px;border-radius:50%;
  background:#ffdbe6;border:3px solid #65c0ea;top:2px;left:50%;transform:translateX(-50%) rotate(-6deg)
}
.previewHoodie::before{
  content:"";width:51px;height:39px;border-radius:17px 17px 22px 22px;border:3px solid #65c0ea;
  background:linear-gradient(#eef9ff,#cdeaff)
}
.previewHoodie::after{
  content:"";position:absolute;width:22px;height:14px;left:50%;top:11px;transform:translateX(-50%);
  border-radius:0 0 14px 14px;background:#fff;border:3px solid #65c0ea;border-top:0
}
.previewVest::before{
  content:"";width:49px;height:38px;border-radius:16px 16px 22px 22px;border:3px solid #65c0ea;
  background:linear-gradient(#ffe6ee,#ffd1dc)
}
.previewVest::after{content:"♥";position:absolute;font-size:18px;color:#ef718c;top:13px}

#cloudArena{
  background:
    radial-gradient(circle at 16% 18%, rgba(255,255,255,.98) 0 7%, transparent 7.6%),
    radial-gradient(circle at 72% 19%, rgba(255,255,255,.95) 0 9%, transparent 9.6%),
    radial-gradient(circle at 45% 72%, rgba(255,255,255,.92) 0 7%, transparent 7.6%),
    linear-gradient(#98dbff,#dff5ff 45%,#f9fcff 100%);
}
#cloudArena::before{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:
    radial-gradient(ellipse at 20% 78%, rgba(255,255,255,.9) 0 8%, transparent 8.6%),
    radial-gradient(ellipse at 52% 82%, rgba(255,255,255,.85) 0 10%, transparent 10.6%),
    radial-gradient(ellipse at 79% 75%, rgba(255,255,255,.85) 0 8%, transparent 8.6%);
  opacity:.95
}
.starTarget{
  width:50px;height:50px;font-size:44px;
  color:#ffcf40;text-shadow:0 2px 0 rgba(255,255,255,.7)
}
.gameCardArt{box-shadow:inset 0 1px 0 rgba(255,255,255,.8), 0 8px 18px rgba(97,124,146,.15)}
.powerBar{
  background:linear-gradient(90deg,#ff8888 0 28%,#ffd767 28% 66%,#78df83 66% 78%,#ffd767 78% 90%,#ff8888 90% 100%);
}
.fartStage{
  background:
    radial-gradient(circle at 20% 18%,rgba(255,255,255,.6) 0 7%,transparent 7.5%),
    radial-gradient(circle at 78% 15%,rgba(255,255,255,.45) 0 5%,transparent 5.5%),
    linear-gradient(#fff5d8,#ffe7cd);
}

.cheek{
  position:absolute;top:42%;width:10.5%;aspect-ratio:1.65;background:rgba(255,81,117,0);
  border-radius:50%;transition:background .25s ease,transform .25s ease;pointer-events:none
}
.cheek.left{left:29.4%;transform:rotate(-5deg)}
.cheek.right{right:29.4%;transform:rotate(5deg)}
#petSprite.blushing .cheek{background:rgba(255,72,105,.56);transform:scale(1.2)}
.brow{
  position:absolute;top:30.7%;width:7.6%;height:4px;border-radius:10px;background:#9a674c;
  opacity:0;transition:opacity .25s
}
.brow.left{left:38%;transform:rotate(16deg)}
.brow.right{right:38%;transform:rotate(-16deg)}
#petSprite.angry .brow{opacity:.95}
.tear{
  position:absolute;top:45%;right:36%;width:8px;height:13px;border-radius:80% 20% 60% 40%;
  background:#72cbe9;transform:rotate(28deg) scale(0);opacity:0;transition:.3s ease
}
#petSprite.sad .tear{transform:rotate(28deg) scale(1);opacity:.9}

.smudge{
  position:absolute;border-radius:50%;background:rgba(118,84,56,.25);
  filter:blur(1px);opacity:0;transition:opacity .25s ease
}
.smudge.s1{left:39%;top:60%;width:10%;height:7%;transform:rotate(12deg)}
.smudge.s2{left:54%;top:67%;width:11%;height:8%;transform:rotate(-8deg)}
.smudge.s3{left:47%;top:49%;width:7%;height:6%;transform:rotate(8deg)}
.smudge.s4{left:31%;top:47%;width:8%;height:6%;transform:rotate(-12deg)}
.smudge.s5{left:60%;top:48%;width:8%;height:6%;transform:rotate(10deg)}
.smudge.s6{left:44%;top:74%;width:8%;height:6%;transform:rotate(5deg)}
#petSprite.dirty1 .smudge.s1,#petSprite.dirty1 .smudge.s2{opacity:.3}
#petSprite.dirty2 .smudge.s1,#petSprite.dirty2 .smudge.s2,#petSprite.dirty2 .smudge.s3,#petSprite.dirty2 .smudge.s4{opacity:.6}
#petSprite.dirty3 .smudge{opacity:.9}

#fxLayer,#scrubFx{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:35}
.floatFx{
  position:absolute;font-size:26px;animation:floatUp 1.15s ease-out forwards;
  filter:drop-shadow(0 3px 4px rgba(0,0,0,.16))
}
@keyframes floatUp{
  from{transform:translateY(0) scale(.8);opacity:0}
  20%{opacity:1}
  to{transform:translateY(-72px) scale(1.15) rotate(8deg);opacity:0}
}
.bubble{
  position:absolute;width:14px;height:14px;border-radius:50%;
  background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.95), rgba(255,255,255,.55) 35%, rgba(126,215,255,.45) 60%, rgba(126,215,255,.08) 100%);
  border:1px solid rgba(255,255,255,.6);animation:bubbleRise 850ms ease-out forwards
}
@keyframes bubbleRise{
  from{transform:translate(-50%,-50%) scale(.6);opacity:.95}
  to{transform:translate(calc(-50% + var(--dx,0px)), calc(-50% - 38px)) scale(1.2);opacity:0}
}

.actions{
  position:absolute;left:8px;right:8px;bottom:calc(env(safe-area-inset-bottom) + 8px);
  display:grid;grid-template-columns:repeat(6,1fr);gap:5px;z-index:40
}
.action{
  min-width:0;height:72px;border-radius:18px;border:2px solid rgba(129,69,35,.25);
  background:linear-gradient(var(--cream),var(--cream2));
  box-shadow:0 5px 13px rgba(60,29,10,.18), inset 0 1px 0 rgba(255,255,255,.9);
  color:var(--ink);font-weight:950;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;
  cursor:pointer;transition:transform .1s ease, filter .1s ease
}
.action:active{transform:translateY(2px) scale(.97);filter:brightness(.98)}
.action .icon{font-size:24px;line-height:1}
.action .label{font-size:10px;letter-spacing:.1px}
.action .soapIcon{
  width:22px;height:16px;border-radius:6px;background:linear-gradient(#e9fbff,#9adbf0);
  border:2px solid #72bbd6;position:relative;display:block
}
.action .soapIcon::before,.action .soapIcon::after{
  content:"";position:absolute;border-radius:50%;background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.95), rgba(255,255,255,.4) 45%, rgba(126,215,255,.25) 75%, rgba(126,215,255,.08) 100%);
  border:1px solid rgba(255,255,255,.6)
}
.action .soapIcon::before{width:9px;height:9px;right:-6px;top:-8px}
.action .soapIcon::after{width:6px;height:6px;right:4px;top:-11px}

.shade{
  position:absolute;inset:0;z-index:60;display:flex;align-items:flex-end;justify-content:center;
  background:rgba(40,19,8,.35);backdrop-filter:blur(2px);opacity:0;pointer-events:none;transition:opacity .2s ease
}
.shade.open{opacity:1;pointer-events:auto}
.sheet{
  width:100%;max-height:72%;overflow:auto;padding:18px 14px calc(env(safe-area-inset-bottom) + 18px);
  border-radius:26px 26px 0 0;background:linear-gradient(#fff8ed,#ffe8c9);color:var(--ink);
  box-shadow:0 -12px 35px rgba(59,25,8,.23);transform:translateY(16px);transition:transform .22s ease
}
.shade.open .sheet{transform:translateY(0)}
.sheetHead{display:flex;align-items:center;justify-content:space-between;gap:12px}
.sheetHead h2{margin:0;font-size:22px}
.close{
  width:36px;height:36px;border:0;border-radius:50%;background:#fff1da;color:var(--ink);
  font-size:21px;font-weight:900
}
.shopGrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.card{
  padding:12px;border-radius:18px;border:2px solid rgba(125,73,40,.15);background:rgba(255,255,255,.58);box-shadow:0 5px 12px rgba(95,51,24,.08)
}
.card .big{font-size:34px}
.card h3{margin:5px 0 2px;font-size:15px}
.card p{margin:0 0 10px;min-height:30px;font-size:11px;opacity:.72}
.buy{width:100%;border:0;border-radius:12px;padding:9px;font-weight:950;color:#71452c;background:#ffd77e}
.buy:disabled{opacity:.45}
.owned{font-size:11px;font-weight:900;opacity:.7;margin-top:6px}
.buyPrice{display:inline-flex;align-items:center;justify-content:center;gap:6px}
.soapCardIcon{
  width:42px;height:30px;border-radius:10px;background:linear-gradient(#e9fbff,#9adbf0);
  border:3px solid #72bbd6;position:relative
}
.soapCardIcon::before,.soapCardIcon::after{
  content:"";position:absolute;border-radius:50%;
  background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.95), rgba(255,255,255,.45) 40%, rgba(126,215,255,.25) 70%, rgba(126,215,255,.08) 100%);
  border:1px solid rgba(255,255,255,.65)
}
.soapCardIcon::before{width:12px;height:12px;right:-8px;top:-10px}
.soapCardIcon::after{width:8px;height:8px;right:6px;top:-14px}

#cleanOverlay{
  position:absolute;inset:0;z-index:75;background:rgba(255,248,238,.08);backdrop-filter:blur(.5px);
  opacity:0;pointer-events:none;transition:.2s ease
}
#cleanOverlay.active{opacity:1;pointer-events:auto}
.cleanTop{
  position:absolute;top:calc(env(safe-area-inset-top) + 10px);left:10px;right:10px;display:flex;gap:8px;align-items:center;z-index:2
}
.cleanPill{
  flex:1;padding:10px 12px;border-radius:16px;background:rgba(255,249,239,.96);
  border:2px solid rgba(117,70,40,.16);color:var(--ink);font-size:12px;font-weight:900;box-shadow:var(--shadow)
}
.cleanExit{
  width:42px;height:42px;border:0;border-radius:50%;background:rgba(255,249,239,.98);color:var(--ink);font-size:22px;font-weight:900;box-shadow:var(--shadow)
}
#cleanTouch{
  position:absolute;inset:0;cursor:none
}
#sponge{
  position:absolute;width:60px;height:44px;left:-999px;top:-999px;transform:translate(-50%,-50%) rotate(-12deg);
  pointer-events:none;z-index:3;opacity:0;transition:opacity .12s ease
}
#cleanOverlay.active #sponge{opacity:1}
#sponge .foam{position:absolute;left:10px;right:10px;top:-10px;height:16px}
#sponge .foam i{
  position:absolute;bottom:0;width:14px;height:14px;border-radius:50%;
  background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.95), rgba(255,255,255,.45) 45%, rgba(126,215,255,.3) 75%, rgba(126,215,255,.08) 100%);
  border:1px solid rgba(255,255,255,.65)
}
#sponge .foam i:nth-child(1){left:0}
#sponge .foam i:nth-child(2){left:11px;width:18px;height:18px}
#sponge .foam i:nth-child(3){left:27px}
#sponge .body{
  position:absolute;inset:10px 0 0;border-radius:14px;background:linear-gradient(#f6d16a,#e8b544);
  border:3px solid #c89227;box-shadow:inset 0 -7px 0 rgba(255,255,255,.18)
}
#cleanMeter{
  position:absolute;left:50%;bottom:92px;transform:translateX(-50%);z-index:2;
