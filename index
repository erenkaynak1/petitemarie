<script>
(() => {
  const SAVE_KEY = "cinnamorollCare_svg_scrub_v3";
  const RATE = { coinsPerMinute:1, hungerPerMinute:.125, cleanlinessPerMinute:.40, happinessPerMinute:.04, energyPerMinute:.06 };
  const defaultState = () => ({
    coins:125, hunger:86, happiness:88, energy:91, cleanliness:96,
    inventory:{apple:2,cake:1,soap:2,ball:0,beret:0,cap:0,visor:0,hoodie:0,vest:0,bikini:0,star:0,slippers:0,sandals:0},
    equipped:{hat:null,outfit:null,shoes:null},
    lastSeen:Date.now()
  });

  let state;
  try {
    state = Object.assign(defaultState(), JSON.parse(localStorage.getItem(SAVE_KEY) || "{}"));
    state.inventory = Object.assign(defaultState().inventory, state.inventory || {});
    state.equipped = Object.assign(defaultState().equipped, state.equipped || {});
  } catch { state = defaultState(); }

  const $ = id => document.getElementById(id);

  // ===== Embedded sound bank =====
  const SOUND_DATA = {
    sing:"data:audio/mpeg;base64,",
    fear:"data:audio/mp4;base64,",
    dirty:"data:audio/mp4;base64,",
    fart:"data:audio/mp4;base64,",
    yawn:"data:audio/mp4;base64,",
    coin:"data:audio/mp4;base64,",
    laugh:"data:audio/mp4;base64,",
    clean:"data:audio/mp4;base64,",
    annoyed:"data:audio/mp4;base64,"
  };

  let audioUnlocked = false;
  const soundBank = Object.fromEntries(
    Object.entries(SOUND_DATA).map(([key,src]) => {
      const a = new Audio(src);
      a.preload = "auto";
      return [key,a];
    })
  );

  function unlockAudio(){
    if(audioUnlocked) return;
    audioUnlocked = true;
    Object.values(soundBank).forEach(a => {
      try{
        a.muted = true;
        const p = a.play();
        if(p && p.then){
          p.then(() => {
            a.pause();
            a.currentTime = 0;
            a.muted = false;
          }).catch(() => { a.muted = false; });
        }else{
          a.pause();
          a.currentTime = 0;
          a.muted = false;
        }
      }catch(_){}
    });
  }

  const activeSounds = new Set();

  function playSound(name, volume=1){
    const base = soundBank[name];
    if(!base || !audioUnlocked) return null;
    try{
      const a = base.cloneNode(true);
      a.volume = Math.max(0, Math.min(1, volume));
      activeSounds.add(a);

      const release = () => activeSounds.delete(a);
      a.addEventListener("ended", release, {once:true});
      a.addEventListener("error", release, {once:true});

      const p = a.play();
      if(p && p.catch) p.catch(release);
      return a;
    }catch(_){
      return null;
    }
  }

  document.addEventListener("pointerdown", unlockAudio, {once:true, capture:true});
  document.addEventListener("touchstart", unlockAudio, {once:true, capture:true});

  const clamp = n => Math.max(0, Math.min(100, n));
  const game = $("game"), petMover = $("petMover"), petSprite = $("petSprite"), fxLayer = $("fxLayer"), scrubFx = $("scrubFx"), thought = $("thought"), eyeTrack = $("eyeTrack");
  const cleanOverlay = $("cleanOverlay"), cleanTouch = $("cleanTouch"), sponge = $("sponge");

  let x = 0, actionBusy = false, thoughtTimer, toastTimer, lastPointerAt = 0, lastBubbleAt = 0, dirtyComplaintShown = false;
  const cleaning = { active:false, down:false, strokes:0 };

  function save(){ state.lastSeen = Date.now(); localStorage.setItem(SAVE_KEY, JSON.stringify(state)); }
  function colorFor(v){ if(v < 25) return "#ef5d62"; if(v < 55) return "#f5b53e"; return "#5ec56f"; }

  function setEyes(ex, ey){ if(eyeTrack) eyeTrack.style.transform = `translate(${ex}px,${ey}px)`; }

  function say(msg, ms=1500){
    thought.textContent = msg;
    thought.classList.add("show");
    clearTimeout(thoughtTimer);
    thoughtTimer = setTimeout(() => thought.classList.remove("show"), ms);
  }

  function toast(msg){
    const t = $("toast");
    t.textContent = msg;
    t.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => t.classList.remove("show"), 1900);
  }

  function applyElapsed(ms){
    const mins = Math.max(0, ms / 60000);
    const earned = mins * RATE.coinsPerMinute;
    state.coins += earned;
    state.hunger = clamp(state.hunger - mins * RATE.hungerPerMinute);
    state.cleanliness = clamp(state.cleanliness - mins * RATE.cleanlinessPerMinute);
    state.happiness = clamp(state.happiness - mins * RATE.happinessPerMinute);
    state.energy = clamp(state.energy - mins * RATE.energyPerMinute);
    return Math.floor(earned);
  }

  function updateDirtClasses(){
    petSprite.classList.remove("dirty1","dirty2","dirty3");
    if(state.cleanliness < 70) petSprite.classList.add("dirty1");
    if(state.cleanliness < 48) petSprite.classList.add("dirty2");
    if(state.cleanliness < 28) petSprite.classList.add("dirty3");
  }


  const cosmeticMap = {
    beret:{slot:"hat",svg:"cos-hat-beret",name:"Pink Beret"},
    cap:{slot:"hat",svg:"cos-hat-cap",name:"Cloud Cap"},
    visor:{slot:"hat",svg:"cos-hat-visor",name:"Candy Visor"},
    hoodie:{slot:"outfit",svg:"cos-outfit-hoodie",name:"Cloud Hoodie"},
    vest:{slot:"outfit",svg:"cos-outfit-vest",name:"Berry Vest"},
    bikini:{slot:"outfit",svg:"cos-outfit-bikini",name:"Beach Bikini"},
    star:{slot:"shoes",svg:"cos-shoes-star",name:"Star Shoes"},
    slippers:{slot:"shoes",svg:"cos-shoes-slippers",name:"Cloud Slippers"},
    sandals:{slot:"shoes",svg:"cos-shoes-sandals",name:"Sunny Sandals"}
  };

  function applyCosmetics(){
    Object.entries(cosmeticMap).forEach(([id,c]) => {
      const el = $(c.svg);
      if(el) el.style.display = state.equipped[c.slot] === id ? "inline" : "none";
    });
  }

  function updateCosmeticsUI(){
    document.querySelectorAll("[data-cosmetic]").forEach(btn => {
      const id = btn.dataset.cosmetic;
      const slot = btn.dataset.slot;
      const price = Number(btn.dataset.price);
      const owned = !!state.inventory[id];
      const equipped = state.equipped[slot] === id;
      btn.classList.toggle("owned", owned);
      btn.classList.toggle("equipped", equipped);
      btn.disabled = !owned && state.coins < price;
      if(!owned) btn.textContent = "★ " + price;
      else if(equipped) btn.textContent = "EQUIPPED ✓";
      else btn.textContent = "EQUIP";
    });
    applyCosmetics();
  }

  function updateUI(){
    [["hunger",state.hunger],["happy",state.happiness],["energy",state.energy],["clean",state.cleanliness]].forEach(([id,val]) => {
      $(id + "Text").textContent = Math.round(val);
      $(id + "Fill").style.width = val + "%";
      $(id + "Fill").style.background = colorFor(val);
    });
    $("coinText").textContent = Math.floor(state.coins).toLocaleString("en-US");
    $("gamesCoinText").textContent = Math.floor(state.coins).toLocaleString("en-US");
    $("appleOwned").textContent = Math.floor(state.inventory.apple || 0);
    $("cakeOwned").textContent = Math.floor(state.inventory.cake || 0);
    $("shopApple").textContent = Math.floor(state.inventory.apple || 0);
    $("shopCake").textContent = Math.floor(state.inventory.cake || 0);
    $("shopSoap").textContent = Math.floor(state.inventory.soap || 0);
    $("shopBall").textContent = state.inventory.ball ? "Yes" : "No";
    $("soapCount").textContent = Math.floor(state.inventory.soap || 0);

    $("eatApple").disabled = (state.inventory.apple || 0) <= 0;
    $("eatCake").disabled = (state.inventory.cake || 0) <= 0;

    petSprite.classList.toggle("angry", state.hunger < 25);
    petSprite.classList.toggle("sad", state.cleanliness < 25);
    petSprite.classList.toggle("sleepy", state.energy < 18 && !petSprite.classList.contains("jump"));
    updateDirtClasses();

    if(state.cleanliness < 45 && !dirtyComplaintShown && !cleaning.active){
      dirtyComplaintShown = true;
      playSound("dirty", .95);
      say("I'm disgustinggg!", 1800);
    } else if(state.cleanliness > 68){
      dirtyComplaintShown = false;
    }

    updateCosmeticsUI();

    document.querySelectorAll("[data-buy]").forEach(btn => {
      const item = btn.dataset.buy, price = Number(btn.dataset.price);
      btn.disabled = state.coins < price || (item === "ball" && state.inventory.ball);
      if(item === "ball" && state.inventory.ball) btn.textContent = "Owned ✓";
    });
  }

  function floatFx(symbol, count=1, spread=35, baseY=58){
    const g = game.getBoundingClientRect(), mover = petMover.getBoundingClientRect();
    for(let i=0;i<count;i++){
      const el = document.createElement("span");
      el.className = "floatFx";
      el.textContent = symbol;
      el.style.left = (mover.left - g.left + mover.width/2 + (Math.random()-.5)*spread) + "px";
      el.style.top = (mover.top - g.top + mover.height*baseY/100 + (Math.random()-.5)*15) + "px";
      fxLayer.appendChild(el);
      setTimeout(() => el.remove(), 1300);
    }
  }

  function bubbleFx(x, y, count=2){
    for(let i=0;i<count;i++){
      const b = document.createElement("span");
      b.className = "bubble";
      b.style.left = x + "px";
      b.style.top = y + "px";
      b.style.setProperty("--dx", ((Math.random()*26)-13) + "px");
      scrubFx.appendChild(b);
      setTimeout(() => b.remove(), 900);
    }
  }

  function anim(cls, ms=800){
    if(actionBusy || cleaning.active) return;
    actionBusy = true;
    petSprite.classList.remove("jump","wiggle","walking");
    void petSprite.offsetWidth;
    petSprite.classList.add(cls);
    setTimeout(() => {
      petSprite.classList.remove(cls);
      actionBusy = false;
      updateUI();
    }, ms);
  }

  function wander(target=null){
    if(actionBusy || cleaning.active) return;
    const max = Math.min(92, window.innerWidth * .22);
    x = target == null ? (Math.random()*2 - 1) * max : target;
    petSprite.classList.add("walking");
    petMover.style.setProperty("--x", x.toFixed(0) + "px");
    setTimeout(() => {
      petSprite.classList.remove("walking");
      if(Math.random() < .3) anim("wiggle", 760);
    }, 1300);
  }

  function fart(){
    if(actionBusy || cleaning.active) return;
    actionBusy = true;
    petSprite.classList.add("farting");
    say("...", 650);
    setTimeout(() => {
      playSound("fart", .8);
      floatFx("💨", 3, 25, 68);
      petSprite.classList.add("blushing");
      setEyes(-3,0);
      say("oops...", 1350);
    }, 430);
    setTimeout(() => {
      petSprite.classList.remove("blushing","farting");
      setEyes(0,0);
      actionBusy = false;
    }, 2100);
  }

  function spiderScare(){
    if(actionBusy || cleaning.active) return;
    actionBusy = true;
    petSprite.classList.add("lookBack");
    setEyes(-3,-1);
    say("...", 450);
    setTimeout(() => {
      petSprite.classList.remove("lookBack");
      petSprite.classList.add("scared");
      setEyes(-4,-1);
      playSound("fear", 1);
      say("It\'s a spider!", 1500);
      floatFx("!", 2, 26, 24);
      state.happiness = clamp(state.happiness - 2);
    }, 430);
    setTimeout(() => {
      petSprite.classList.remove("scared");
      setEyes(0,0);
      actionBusy = false;
      updateUI();
      save();
    }, 1650);
  }

  const touchLines = [
    "Don't touch me!",
    "Hey! That tickles!",
    "Would you like to pet somewhere else too?",
    "My ears are ticklish!",
    "Pat my head!",
    "Hehe... again?",
    "Careful!",
    "That was unexpected!"
  ];

  function reactToTouch(e){
    if(cleaning.active || document.querySelector(".shade.open") || $("gamesScreen").classList.contains("open")) return;

    const rect = petSprite.getBoundingClientRect();
    const relativeY = (e.clientY - rect.top) / rect.height;

    // Only the lower third of the character triggers the special line.
    const line = relativeY >= 0.67
      ? "aww yeah keep touch eren jr"
      : touchLines[Math.floor(Math.random() * touchLines.length)];

    say(line, 1700);
    if(relativeY >= 0.67) playSound("laugh", .9);

    if(["Don't touch me!","Careful!","That was unexpected!"].includes(line)){
      playSound("annoyed", 1);
    } else if(["Hey! That tickles!","Hehe... again?","My ears are ticklish!"].includes(line)){
      playSound("laugh", .95);
    }

    if(!actionBusy){
      petSprite.classList.add("blushing");
      anim("wiggle", 650);
      setTimeout(() => petSprite.classList.remove("blushing"), 900);
    }
  }

  function singSong(){
    if(actionBusy || cleaning.active) return;
    actionBusy = true;

    const song = playSound("sing", .95);
    const fallbackMs = 10000;

    say("♪ La la la... ♪", fallbackMs);
    floatFx("♪", 3, 40, 24);
    petSprite.classList.add("blushing");

    const finishSong = () => {
      petSprite.classList.remove("blushing");
      actionBusy = false;
      say("♪", 450);
    };

    if(song){
      song.addEventListener("ended", finishSong, {once:true});
      song.addEventListener("error", finishSong, {once:true});
    } else {
      setTimeout(finishSong, fallbackMs);
    }
  }

  function autonomousAction(){
    if(document.hidden || actionBusy || cleaning.active || document.querySelector(".shade.open")) return;
    if(state.hunger < 22 && Math.random() < .45){ say("I'm hungry!", 1500); anim("wiggle", 800); return; }
    if(state.cleanliness < 22 && Math.random() < .4){ say("I need a bath...", 1500); return; }
    if(state.energy < 15 && Math.random() < .45){ say("So sleepy...", 1400); floatFx("💤",2,30,15); return; }

    const r = Math.random();
    if(r < .42) wander();
    else if(r < .63) anim("jump", 760);
    else if(r < .79) anim("wiggle", 780);
    else if(r < .84) fart();
    else if(r < .92) spiderScare();
    else if(r < .97){ singSong(); }
  }

  function scheduleAuto(){
    const delay = 4200 + Math.random()*5000;
    setTimeout(() => { autonomousAction(); scheduleAuto(); }, delay);
  }

  function openShade(id){ $(id).classList.add("open"); updateUI(); }
  function closeShade(id){ $(id).classList.remove("open"); }

  function beginCleaning(){
    if(cleaning.active) return;
    if((state.inventory.soap || 0) < 1){
      toast("You need Bubble Soap first.");
      openShade("shopShade");
      return;
    }
    state.inventory.soap--;
    cleaning.active = true;
    cleaning.down = false;
    cleaning.strokes = 0;
    cleanOverlay.classList.add("active");
    cleanOverlay.setAttribute("aria-hidden","false");
    say("Bath time!", 1200);
    petSprite.classList.add("blushing");
    updateUI();
    save();
  }

  function endCleaning(showDone=true){
    cleaning.active = false;
    cleaning.down = false;
    cleanOverlay.classList.remove("active");
    cleanOverlay.setAttribute("aria-hidden","true");
    sponge.style.left = "-999px";
    sponge.style.top = "-999px";
    petSprite.classList.remove("blushing");
    if(showDone){
      toast("Cleaning finished!");
      if(state.cleanliness >= 99) playSound("clean", .95);
    }
    save();
    updateUI();
  }

  function scrubAt(clientX, clientY){
    const gameRect = game.getBoundingClientRect();
    const petRect = petSprite.getBoundingClientRect();
    const lx = clientX - gameRect.left;
    const ly = clientY - gameRect.top;

    sponge.style.left = lx + "px";
    sponge.style.top = ly + "px";

    const insidePet = clientX >= petRect.left && clientX <= petRect.right && clientY >= petRect.top && clientY <= petRect.bottom;
    if(!cleaning.down || !insidePet) return;

    cleaning.strokes++;
    state.cleanliness = clamp(state.cleanliness + 0.45);
    if(state.cleanliness > 60) state.happiness = clamp(state.happiness + 0.02);

    const localX = lx + (Math.random()*18 - 9);
    const localY = ly + (Math.random()*14 - 7);
    const now = Date.now();
    if(now - lastBubbleAt > 45){
      bubbleFx(localX, localY, 3);
      lastBubbleAt = now;
    }
    if(cleaning.strokes % 18 === 0){
      say("So fluffy!", 800);
      floatFx("🫧", 2, 35, 42);
    }
    if(state.cleanliness >= 99){
      state.cleanliness = 100;
      state.happiness = clamp(state.happiness + 4);
      floatFx("✨", 3, 40, 35);
      setTimeout(() => endCleaning(true), 250);
    }
    updateUI();
  }

  const now = Date.now();
  const awayMs = Math.max(0, now - (state.lastSeen || now));
  const offlineEarned = applyElapsed(awayMs);
  state.lastSeen = now;

  // General pointer-based eye tracking
  game.addEventListener("pointermove", e => {
    if(cleaning.active) scrubAt(e.clientX, e.clientY);
    const r = game.getBoundingClientRect();
    const nx = ((e.clientX-r.left)/r.width - .5) * 2;
    const ny = ((e.clientY-r.top)/r.height - .5) * 2;
    if(!cleaning.active){
      setEyes(Math.max(-3,Math.min(3,nx*3)), Math.max(-2,Math.min(2,ny*2)));
      lastPointerAt = Date.now();
    }
  });
  game.addEventListener("pointerleave", () => { if(!cleaning.active) setEyes(0,0); });

  setInterval(() => {
    if(Date.now() - lastPointerAt > 2400 && !actionBusy && !cleaning.active){
      const ex = (Math.random()*2 - 1) * 2.2;
      const ey = (Math.random()*2 - 1) * 1.2;
      setEyes(ex, ey);
      setTimeout(() => {
        if(Date.now() - lastPointerAt > 2400 && !cleaning.active) setEyes(0,0);
      }, 700);
    }
  }, 3300);

  petSprite.addEventListener("pointerdown", e => {
    e.stopPropagation();
    reactToTouch(e);
  });

  // Cleaning overlay drag mechanics
  cleanTouch.addEventListener("pointerdown", e => { cleaning.down = true; scrubAt(e.clientX, e.clientY); cleanTouch.setPointerCapture(e.pointerId); });
  cleanTouch.addEventListener("pointermove", e => scrubAt(e.clientX, e.clientY));
  cleanTouch.addEventListener("pointerup", () => cleaning.down = false);
  cleanTouch.addEventListener("pointercancel", () => cleaning.down = false);
  $("cleanExit").addEventListener("click", () => endCleaning(true));

  document.querySelectorAll("[data-close]").forEach(btn => btn.addEventListener("click", () => closeShade(btn.dataset.close)));
  document.querySelectorAll(".shade").forEach(shade => shade.addEventListener("click", e => { if(e.target === shade) shade.classList.remove("open"); }));

  $("feedBtn").addEventListener("click", () => openShade("foodShade"));
  $("shopBtn").addEventListener("click", () => openShade("shopShade"));
  $("coinPill").addEventListener("click", () => openShade("shopShade"));

  $("eatApple").addEventListener("click", () => {
    if((state.inventory.apple || 0) < 1) return;
    state.inventory.apple--;
    state.hunger = clamp(state.hunger + 22);
    state.happiness = clamp(state.happiness + 2);
    closeShade("foodShade");
    anim("wiggle", 850);
    say("Yum!", 1100);
    floatFx("💗", 2, 28, 32);
    save(); updateUI();
  });

  $("eatCake").addEventListener("click", () => {
    if((state.inventory.cake || 0) < 1) return;
    state.inventory.cake--;
    state.hunger = clamp(state.hunger + 38);
    state.happiness = clamp(state.happiness + 5);
    closeShade("foodShade");
    anim("jump", 780);
    say("My favorite!", 1300);
    floatFx("💗", 4, 50, 28);
    save(); updateUI();
  });

  $("petBtn").addEventListener("click", () => {
    if(cleaning.active) return;
    state.happiness = clamp(state.happiness + 6);
    petSprite.classList.add("blushing");
    anim("wiggle", 800);
    playSound("laugh", .95);
    say("Hehe ♥", 1000);
    floatFx("💗", 4, 55, 30);
    setTimeout(() => petSprite.classList.remove("blushing"), 1200);
    save(); updateUI();
  });

  $("sleepBtn").addEventListener("click", () => {
    if(actionBusy || cleaning.active) return;
    actionBusy = true;
    playSound("yawn", 1);
    say("Good night...", 1300);
    petSprite.classList.add("sleepPose");
    floatFx("💤", 3, 45, 15);
    setTimeout(() => {
      state.energy = clamp(state.energy + 28);
      state.happiness = clamp(state.happiness + 3);
      petSprite.classList.remove("sleepPose");
      actionBusy = false;
      say("Morning!", 900);
      save(); updateUI();
    }, 3400);
  });

  $("playBtn").addEventListener("click", () => {
    if(cleaning.active) return;
    openGames();
  });

  $("cleanBtn").addEventListener("click", beginCleaning);


  document.querySelectorAll("[data-cosmetic]").forEach(btn => btn.addEventListener("click", () => {
    const id = btn.dataset.cosmetic;
    const slot = btn.dataset.slot;
    const price = Number(btn.dataset.price);

    if(!state.inventory[id]){
      if(state.coins < price){ toast("Not enough coins yet."); return; }
      state.coins -= price;
      state.inventory[id] = 1;
      state.equipped[slot] = id;
      toast("Bought & equipped!");
      floatFx("★",2,25,20);
    } else {
      state.equipped[slot] = state.equipped[slot] === id ? null : id;
      toast(state.equipped[slot] ? "Equipped!" : "Removed.");
    }
    save();
    updateUI();
  }));

  document.querySelectorAll("[data-buy]").forEach(btn => btn.addEventListener("click", () => {
    const item = btn.dataset.buy, price = Number(btn.dataset.price);
    if(state.coins < price){ toast("Not enough coins yet."); return; }
    if(item === "ball" && state.inventory.ball) return;
    state.coins -= price;
    if(item === "ball") state.inventory.ball = 1;
    else state.inventory[item] = (state.inventory[item] || 0) + 1;
    floatFx("★", 2, 25, 20);
    toast("Bought!");
    save(); updateUI();
  }));


  // ===== Mini games =====
  const gamesScreen = $("gamesScreen"), gamesHub = $("gamesHub"), cloudGame = $("cloudGame"), fartGame = $("fartGame");
  let cloudTimer = null, cloudSeconds = 10, cloudHits = 0, cloudRunning = false, cloudStarLife = null;
  let fartRAF = 0, fartRunning = false, fartNeedle = 0, fartDir = 1, fartTries = 3, fartEarned = 0, fartLastTs = 0;

  function openGames(){
    gamesScreen.classList.add("open");
    gamesScreen.setAttribute("aria-hidden","false");
    showGameHome();
    updateUI();
  }
  function closeGames(){
    stopCloudGame(false);
    stopFartMotion();
    gamesScreen.classList.remove("open");
    gamesScreen.setAttribute("aria-hidden","true");
    updateUI();
  }
  function showGameHome(){
    stopCloudGame(false);
    stopFartMotion();
    gamesHub.style.display = "block";
    cloudGame.style.display = "none";
    fartGame.style.display = "none";
  }

  $("gamesBack").addEventListener("click", closeGames);
  document.querySelectorAll("[data-game-home]").forEach(btn => btn.addEventListener("click", showGameHome));
  $("openCloudGame").addEventListener("click", () => {
    gamesHub.style.display = "none"; cloudGame.style.display = "block"; fartGame.style.display = "none";
  });
  $("openFartGame").addEventListener("click", () => {
    gamesHub.style.display = "none"; fartGame.style.display = "block"; cloudGame.style.display = "none";
  });

  function spawnStar(){
    if(!cloudRunning) return;
    const arena = $("cloudArena");
    arena.querySelectorAll(".targetBase").forEach(x => x.remove());
    if(cloudStarLife){ clearTimeout(cloudStarLife); cloudStarLife = null; }

    const roll = Math.random();
    const type = roll < 0.66 ? "star" : (roll < 0.82 ? "bomb" : "poop");
    const target = document.createElement("button");
    target.className = "targetBase " + (type === "star" ? "starTarget" : type === "bomb" ? "bombTarget" : "poopTarget");
    target.textContent = type === "star" ? "★" : (type === "bomb" ? "💣" : "💩");
    target.style.left = (12 + Math.random()*76) + "%";
    target.style.top = (14 + Math.random()*70) + "%";
    target.addEventListener("pointerdown", e => {
      e.preventDefault();
      if(!cloudRunning) return;

      if(type === "star"){
        cloudHits++;
        $("cloudHits").textContent = cloudHits;
        $("cloudResult").textContent = "Nice catch!";
      } else if(type === "bomb"){
        state.coins = Math.max(0, state.coins - 8);
        $("cloudResult").textContent = "Boom! -8 coins";
        updateUI();
      } else {
        state.coins = Math.max(0, state.coins - 5);
        $("cloudResult").textContent = "Eww... -5 coins";
        updateUI();
      }

      target.remove();
      spawnStar();
    });
    arena.appendChild(target);

    cloudStarLife = setTimeout(() => {
      if(target.isConnected) target.remove();
      if(cloudRunning) spawnStar();
    }, 850);
  }

  function stopCloudGame(reward){
    if(cloudTimer){ clearInterval(cloudTimer); cloudTimer = null; }
    if(cloudStarLife){ clearTimeout(cloudStarLife); cloudStarLife = null; }
    cloudRunning = false;
    $("cloudArena").querySelectorAll(".starTarget").forEach(x => x.remove());
    if(reward){
      const coins = Math.min(36, cloudHits * 3);
      state.coins += coins;
      state.energy = clamp(state.energy - 4);
      state.cleanliness = clamp(state.cleanliness - 3);
      state.happiness = clamp(state.happiness + 3);
      $("cloudResult").textContent = `Nice! ${cloudHits} stars · +${coins} coins`;
      if(coins > 0) playSound("coin", 1);
      save(); updateUI();
    }
    $("cloudStart").disabled = false;
  }

  $("cloudStart").addEventListener("click", () => {
    if(cloudRunning) return;
    if(state.energy < 4){ $("cloudResult").textContent = "Cinna is too sleepy. Rest first."; return; }
    cloudSeconds = 10; cloudHits = 0; cloudRunning = true;
    $("cloudTime").textContent = cloudSeconds;
    $("cloudHits").textContent = "0";
    $("cloudResult").textContent = "Catch them!";
    $("cloudStart").disabled = true;
    spawnStar();
    cloudTimer = setInterval(() => {
      cloudSeconds--;
      $("cloudTime").textContent = cloudSeconds;
      if(cloudSeconds <= 0) stopCloudGame(true);
    },1000);
  });

  function stopFartMotion(){
    fartRunning = false;
    cancelAnimationFrame(fartRAF);
    fartRAF = 0;
  }

  function fartLoop(ts){
    if(!fartRunning) return;
    if(!fartLastTs) fartLastTs = ts;
    const dt = Math.min(.04,(ts-fartLastTs)/1000);
    fartLastTs = ts;
    fartNeedle += fartDir * 120 * dt;
    if(fartNeedle >= 100){ fartNeedle = 100; fartDir = -1; }
    if(fartNeedle <= 0){ fartNeedle = 0; fartDir = 1; }
    $("powerNeedle").style.left = fartNeedle + "%";
    fartRAF = requestAnimationFrame(fartLoop);
  }

  function startFartMotion(){
    fartRunning = true; fartLastTs = 0; fartNeedle = 0; fartDir = 1;
    $("powerNeedle").style.left = "0%";
    fartRAF = requestAnimationFrame(fartLoop);
  }

  $("fartStart").addEventListener("click", () => {
    if(state.energy < 4){ $("fartResult").textContent = "Cinna is too sleepy. Rest first."; return; }
    fartTries = 3; fartEarned = 0;
    $("fartTries").textContent = fartTries;
    $("fartEarned").textContent = fartEarned;
    $("fartResult").textContent = "Hit FART! in the green zone.";
    $("fartStart").style.display = "none";
    $("fartTap").style.display = "block";
    startFartMotion();
  });

  $("fartTap").addEventListener("click", () => {
    if(!fartRunning) return;
    stopFartMotion();
    playSound("fart", .8);

    const distance = Math.abs(fartNeedle - 72);
    let reward = Math.round(12 - distance / 5.4);
    reward = Math.max(2, Math.min(12, reward));
    fartEarned += reward;
    fartTries--;

    $("fartTries").textContent = fartTries;
    $("fartEarned").textContent = fartEarned;
    $("fartCloud").classList.add("embarrassed");
    $("fartPuff").classList.remove("go");
    void $("fartPuff").offsetWidth;
    $("fartPuff").classList.add("go");
    $("fartResult").textContent = reward >= 10 ? `Perfect puff! +${reward}` : `Pffft! +${reward}`;

    setTimeout(() => $("fartCloud").classList.remove("embarrassed"), 650);

    if(fartTries <= 0){
      state.coins += fartEarned;
      state.energy = clamp(state.energy - 4);
      state.cleanliness = clamp(state.cleanliness - 2);
      state.happiness = clamp(state.happiness + 4);
      $("fartResult").textContent = `Round complete · +${fartEarned} coins`;
      if(fartEarned > 0) playSound("coin", 1);
      $("fartTap").style.display = "none";
      $("fartStart").style.display = "block";
      $("fartStart").textContent = "PLAY AGAIN";
      save(); updateUI();
    } else {
      setTimeout(startFartMotion, 650);
    }
  });


  let lastTick = Date.now();
  setInterval(() => {
    const t = Date.now(), dt = t - lastTick;
    lastTick = t;
    applyElapsed(dt);
    state.lastSeen = t;
    updateUI();
  }, 1000);

  setInterval(save, 5000);

  document.addEventListener("visibilitychange", () => {
    if(document.hidden) save();
    else {
      const t = Date.now();
      const ms = Math.max(0, t - (state.lastSeen || t));
      const earned = applyElapsed(ms);
      state.lastSeen = t;
      lastTick = t;
      if(earned > 0){
        const b = $("offlineBanner");
        b.textContent = `Welcome back! +${earned} coins while you were away`;
        b.classList.add("show");
        setTimeout(() => b.classList.remove("show"), 3300);
      }
      updateUI();
      save();
    }
  });

  window.addEventListener("pagehide", save);

  if(offlineEarned > 0 && awayMs > 60000){
    const b = $("offlineBanner");
    b.textContent = `Welcome back! +${offlineEarned} coins while you were away`;
    setTimeout(() => b.classList.add("show"), 450);
    setTimeout(() => b.classList.remove("show"), 3800);
  }

  updateUI();
  scheduleAuto();
  setTimeout(() => { say("Hi! ♥", 1200); anim("wiggle", 800); }, 650);
})();
</script>
</body>
</html>
