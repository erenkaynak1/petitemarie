.previewVisor::before{
  content:"";width:52px;height:18px;border-radius:999px;background:linear-gradient(#ffe8f0,#ffc1d1);
  border:3px solid #65c0ea;position:relative;top:-4px
}
.previewVisor::after{
  content:"";position:absolute;width:38px;height:11px;border-radius:0 0 14px 14px;
  background:#ffc1d1;border:3px solid #65c0ea;border-top:0;top:18px;left:50%;transform:translateX(-50%)
