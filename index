/* ===== Mini-game screen ===== */
#gamesScreen{
  position:absolute;inset:0;z-index:90;display:none;overflow:hidden;
  background:
    radial-gradient(circle at 18% 18%,rgba(255,255,255,.95) 0 8%,transparent 8.5%),
    radial-gradient(circle at 78% 14%,rgba(255,255,255,.9) 0 10%,transparent 10.5%),
    linear-gradient(#aee6ff 0%,#e9f8ff 54%,#fff2dc 100%);
  color:#674129
}
#gamesScreen.open{display:block}
.gamesHeader{
  position:absolute;top:calc(env(safe-area-inset-top) + 10px);left:10px;right:10px;z-index:5;
  display:flex;align-items:center;gap:8px
}
.gamesBack{
  width:42px;height:42px;border:0;border-radius:50%;background:rgba(255,255,255,.94);
  color:#674129;font-size:24px;font-weight:1000;box-shadow:var(--shadow)
}
.gamesTitle{
  flex:1;padding:10px 14px;border-radius:18px;background:rgba(255,255,255,.92);
  box-shadow:var(--shadow);font-size:16px;font-weight:1000
}
.gamesCoins{
  padding:10px 12px;border-radius:18px;background:rgba(255,255,255,.92);
  box-shadow:var(--shadow);font-weight:1000;font-size:12px
}
#gamesHub,#cloudGame,#fartGame{
  position:absolute;inset:76px 12px 14px;overflow:auto;padding-bottom:18px
}
#cloudGame,#fartGame{display:none}
.gameIntro{text-align:center;margin:10px 0 14px}
.gameIntro h2{margin:0 0 5px;font-size:25px}
.gameIntro p{margin:0;font-size:13px;opacity:.75}
.gameCard{
  width:100%;border:0;border-radius:25px;margin:10px 0;padding:18px;
  background:rgba(255,255,255,.9);box-shadow:0 10px 25px rgba(65,82,95,.16);
  color:#674129;text-align:left;display:flex;align-items:center;gap:15px
}
.gameCard:active{transform:scale(.99)}
.gameCardArt{
  flex:0 0 84px;height:84px;border-radius:24px;display:grid;place-items:center;position:relative;overflow:hidden
}
.cloudArt{background:linear-gradient(#bfeeff,#f6fcff)}
.cloudArt::before{
  content:"★";font-size:48px;color:#ffc845;filter:drop-shadow(0 3px 0 rgba(185,121,20,.2))
}
.fartArt{background:linear-gradient(#fff1bf,#ffe3bd)}
.fartArt::before{
  content:"";width:52px;height:36px;border-radius:50%;background:#fff;border:3px solid #65c0ea;
  box-shadow:-23px 12px 0 -8px #fff,-23px 12px 0 -5px #65c0ea
}
.fartArt::after{
  content:"";position:absolute;right:7px;bottom:18px;width:28px;height:13px;border-radius:50%;
  border-top:5px solid #d7d7d7;transform:rotate(10deg)
}
.gameCardText h3{margin:0 0 5px;font-size:19px}
.gameCardText p{margin:0;font-size:12px;opacity:.72}
.rewardLine{margin-top:8px;font-size:11px;font-weight:1000;color:#a86a0c}

.miniPanel{
  min-height:100%;border-radius:26px;background:rgba(255,255,255,.9);
  box-shadow:0 10px 28px rgba(64,91,108,.16);padding:15px;position:relative
}
.miniTop{display:flex;align-items:center;justify-content:space-between;gap:8px}
.miniBack{
  border:0;border-radius:14px;padding:8px 11px;background:#fff0da;color:#674129;font-weight:1000
}
.scorePill{
  padding:8px 11px;border-radius:14px;background:#fff0da;font-size:12px;font-weight:1000
}
#cloudArena{
  position:relative;height:55vh;max-height:470px;min-height:330px;margin-top:12px;border-radius:24px;overflow:hidden;
  background:
    radial-gradient(ellipse at 18% 28%,#fff 0 9%,transparent 9.5%),
    radial-gradient(ellipse at 72% 40%,#fff 0 11%,transparent 11.5%),
    radial-gradient(ellipse at 45% 73%,#fff 0 8%,transparent 8.5%),
    linear-gradient(#a8e3ff,#e8f8ff);
  border:3px solid rgba(101,192,234,.55)
}
.starTarget{
  position:absolute;width:60px;height:60px;border:0;background:transparent;color:#ffc83d;
  font-size:54px;line-height:1;filter:drop-shadow(0 4px 1px rgba(171,104,0,.18));
  transform:translate(-50%,-50%);animation:starPulse .55s ease-in-out infinite alternate
}
@keyframes starPulse{from{transform:translate(-50%,-50%) scale(.92) rotate(-5deg)}to{transform:translate(-50%,-50%) scale(1.08) rotate(5deg)}}
.startGameBtn{
  width:100%;border:0;border-radius:18px;padding:13px;margin-top:12px;
  background:#ffd36a;color:#68411f;font-weight:1000;font-size:15px;box-shadow:0 5px 0 #dca33c
}
.startGameBtn:active{transform:translateY(3px);box-shadow:0 2px 0 #dca33c}

.fartStage{
  height:280px;margin-top:18px;border-radius:24px;background:linear-gradient(#fff5d8,#ffe7cd);
  display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden
}
.fartCloud{
  position:relative;width:125px;height:92px;margin-bottom:20px;
  background:#fff;border:4px solid #65c0ea;border-radius:50%;
  box-shadow:-45px 20px 0 -15px #fff,-45px 20px 0 -11px #65c0ea,45px 15px 0 -18px #fff,45px 15px 0 -14px #65c0ea
}
.fartCloud::before,.fartCloud::after{
  content:"";position:absolute;background:#52b8e7;border-radius:50%;width:9px;height:14px;top:35px
}
.fartCloud::before{left:39px}.fartCloud::after{right:39px}
.fartMouth{
  position:absolute;left:50%;top:52px;width:20px;height:12px;transform:translateX(-50%);
  border-bottom:4px solid #52b8e7;border-radius:0 0 50% 50%
}
.fartCloud.embarrassed{animation:fartShake .18s infinite alternate}
@keyframes fartShake{from{transform:rotate(-2deg)}to{transform:rotate(2deg)}}
.fartPuff{
  position:absolute;left:50%;top:170px;width:28px;height:14px;border-radius:50%;
  border-top:6px solid #c7c7c7;opacity:0
}
.fartPuff.go{animation:puffGo .75s ease-out}
@keyframes puffGo{0%{opacity:0;transform:translateX(0) scale(.5)}20%{opacity:1}100%{opacity:0;transform:translateX(110px) scale(1.8)}}
.powerBar{
  position:relative;width:88%;height:28px;border-radius:999px;margin:12px auto 8px;
  background:linear-gradient(90deg,#ff8e8e 0 20%,#ffd767 20% 55%,#73d982 55% 88%,#ffd767 88% 100%);
  border:3px solid rgba(112,68,36,.23);overflow:visible
}
.powerNeedle{
  position:absolute;top:-9px;left:0;width:8px;height:42px;border-radius:5px;background:#70452d;
  transform:translateX(-50%);box-shadow:0 2px 4px rgba(0,0,0,.2)
}
.fartBtn{background:#ffb36a;box-shadow:0 5px 0 #df8344}
.gameResult{text-align:center;font-size:13px;font-weight:1000;min-height:22px;margin-top:8px}

@media (max-width:360px){
  .hud{gap:4px;left:6px;right:6px}
  .stat .top{font-size:10px}
  .stat .ico{font-size:14px}
  #petMover{width:min(80vw,320px)}
  .actions{gap:4px;left:5px;right:5px}
  .action{height:66px}
  .action .icon{font-size:22px}
  .action .label{font-size:9px}
}
