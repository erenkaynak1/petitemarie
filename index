}
.previewCap::after{
  content:"";position:absolute;width:26px;height:8px;border-radius:50%;
  background:#9edcf5;border:3px solid #65c0ea;right:13px;bottom:8px;transform:rotate(8deg)
}
.previewHoodie::before,.previewVest::before{
  content:"";width:49px;height:38px;border-radius:15px 15px 20px 20px;border:3px solid #65c0ea
}
.previewHoodie::before{background:#d9efff}
.previewVest::before{background:#ffd0d9}
.previewHoodie::after{
  content:"☁";position:absolute;font-size:20px;line-height:1;color:#fff;filter:drop-shadow(0 1px 0 #65c0ea)
